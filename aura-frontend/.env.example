# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Meta / Facebook Login for Business
VITE_META_APP_ID=1016361021042414
META_APP_SECRET=your_meta_app_secret

# X / Twitter API v2
VITE_X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret

# OAuth Callback URLs
# En desarrollo: por defecto usa http://localhost:5173/oauth/meta/callback (no necesita config)
# En producción: configurar con la URL de la Edge Function de Supabase
# VITE_META_CALLBACK_URL=https://[project-ref].supabase.co/functions/v1/auth-meta-callback
# VITE_X_CALLBACK_URL=https://[project-ref].supabase.co/functions/v1/auth-x-callback
